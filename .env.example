# Username + password accepted on the login page
AUTH_USERNAME=
AUTH_PASSWORD=
# Signs the session cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Google sign-in (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# and add the redirect URI  <site origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts that may sign in. Empty = nobody.
GOOGLE_ALLOWED_EMAILS=
